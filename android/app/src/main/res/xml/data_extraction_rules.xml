<?xml version="1.0" encoding="utf-8"?>
<!--
  Data kas, utang, dan penjualan tidak boleh dicadangkan ke Google Cloud
  atau ditransfer ke perangkat lain: bisa terjadi kebocoran data atau
  restore ganda yang merusak angka pembukuan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
